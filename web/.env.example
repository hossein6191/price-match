# The deployed Price Match contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts) with scripted readings of the demo
# pages, no wallet and no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository, for the footer's Source link. On Vercel the repository the site was built from is
# used when this is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables); elsewhere the link is hidden.
NEXT_PUBLIC_REPO_URL=

# The demo shop's id, only when the server has no DEMO_SHOP_KEY: the server otherwise finds the shop the key opened.
NEXT_PUBLIC_DEMO_SHOP=

# Server only. A throwaway Studio test key that opened the demo shop (tools/open-demo-shop.mjs). POST /api/demo/restock
# signs one kind of call with it: fund() on the demo shop when a product is no longer covered by its free bond.
# Never a key that holds anything real. Pasted with or without 0x, with or without quotes. Unset: the site works,
# the demo shop still sells while its bond covers it, and GET /api/demo/status says exactly why it cannot top up.
DEMO_SHOP_KEY=
